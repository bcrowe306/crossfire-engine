package crossfire

import "core:fmt"
import "core:log"
import "core:strconv"
import "core:strings"
import sdl "vendor:sdl3"

/*
The game player: runs a project saved by the editor.

	player                                    an exported game: play the project next to the program
	                                          (its data/ folder), else the current folder
	player <project folder>                   play it, from its start scene
	player <project folder> --scene <name>    play it from another scene (the editor's Play Scene)
	player ... --physics-debug                draw every physics shape, whatever the project says
	player ... --dev                          developer keys (the editor's Play): F9 shows / hides shapes, F10 the debug overlay
	player ... --renderer <name>              draw with this renderer (vulkan, opengl, software, ...),
	                                          whatever the project says
	player ... --quit-after <seconds>         quit after that long (smoke tests of exported games)
	player ... --audio-device <name>          play sound on that device (the editor's Settings for Play)
	player --describe-scripts                 print the registered scripts as JSON, and exit
	player --list-audio-devices               print the playback devices' names, one a line, and exit

`Player_Run` is the whole program. The engine's own `player/` package calls it with no game code;
a project with scripts gets its own player, generated by the editor, that imports the project's
`scripts` package (which registers its scripts from `@(init)` procedures) and calls it:

	package main

	import "core:os"
	import e "engine:."
	import scripts "project:scripts"
	_ :: scripts

	main :: proc() {
		os.exit(e.Player_Run(os.args))
	}

Inputs:
- args: The command line, program name first

Returns:
- The exit code: 0 after a normal quit (or `--describe-scripts`), 1 if the command line is wrong
  or the project couldn't be loaded or started
*/
Player_Run :: proc(args: []string) -> int {
	// The engine's logger (logging.odin): from the editor (--dev) debug lines too and standard
	// output only; exported games also write to the platform's log
	context.logger = Log_CreateLogger(&playerLogSink)
	options, ok := Player_ParseArgs(args)
	playerLogSink.minimum = options.dev ? .Debug : .Info
	playerLogSink.platformLog = !options.dev
	Log_HookSDL(&playerLogSink)
	if !ok {
		log.error("Usage: player <project folder> [--scene <name>] [--physics-debug] [--dev] [--renderer <name>] [--audio-device <name>] | player --describe-scripts | player --list-audio-devices")
		return 1
	}
	if options.describe {
		fmt.println(Script_DescribeJSON(context.temp_allocator))
		return 0
	}
	if options.listAudioDevices {
		if !sdl.Init({.AUDIO}) {
			log.error("Error starting SDL's audio: ", sdl.GetError())
			return 1
		}
		for name in Audio_PlaybackDevices(context.temp_allocator) do fmt.println(name)
		sdl.Quit()
		return 0
	}

	app := Application{}
	if !Player_Setup(options, &app) do return 1
	defer ProjectData_Destroy(&playerProject)
	defer Application_Cleanup(&app)
	Application_Run(&app)
	log.info("Game closed")
	return 0
}

// Where the player's log lines go (Player_Run's logger, and SDL's messages)
@(private="file")
playerLogSink: LogSink

/*
Loads the project `options` names and opens its window, with the start scene (or
`options.scene`) queued in `app`. Shared by `Player_Run` and the browser's `Player_StartWeb`;
the caller then runs frames and finally calls `Application_Cleanup`.

Inputs:
- options: What to play (`Player_ParseArgs`)
- app: The application to set up (zero-initialized)

Returns:
- false (logged) if the project or the window couldn't be set up
*/
Player_Setup :: proc(options: PlayerOptions, app: ^Application) -> bool {
	projectDir = options.projectDir
	if !options.folderGiven do projectDir = Player_FindExportedProject()
	projectFile := strings.clone(JoinPath(projectDir, "project.xml"))
	defer delete(projectFile)

	err: ProjectError
	playerProject, err = LoadProjectFile(projectFile)
	if err != .None {
		log.errorf("Couldn't load project %s: %v", projectFile, err)
		return false
	}
	// --restore: the snapshot's scene, unless one was named (hot_reload.odin)
	options := options
	restoreText = ""
	if options.restore != "" {
		if data, read := Platform_ReadFile(options.restore); read {
			if snapshot, ok := Snapshot_Parse(string(data)); ok {
				restoreText = strings.clone(string(data))
				if options.scene == "" do options.scene = strings.clone(snapshot.scene)
			} else {
				log.warnf("%s isn't a snapshot: starting fresh", options.restore)
			}
		} else {
			log.warnf("Couldn't read %s: starting fresh", options.restore)
		}
	}
	if options.scene != "" {
		known := false
		for ref in playerProject.scenes do if ref.name == options.scene do known = true
		if !known {
			log.errorf("No scene named '%s' in %s", options.scene, projectFile)
			return false
		}
		delete(playerProject.startScene)
		playerProject.startScene = strings.clone(options.scene)
	}
	log.infof("Playing '%s' (%d scenes, start: %s, %d scripts registered)",
		playerProject.name, len(playerProject.scenes), playerProject.startScene, len(Script_All()))

	if options.renderer != "" {
		if backend, ok := RenderBackend_Parse(options.renderer); ok do playerProject.renderer = backend
		else do log.warnf("Unknown renderer '%s': using the project's", options.renderer)
	}
	// The project's sound format, on the device the command line names (the machine's choice)
	audio := playerProject.audioOutput
	audio.device = options.audioDevice
	// Shaders run on the GPU renderer: Auto picks it for projects that use them
	if playerProject.renderer == .Auto && playerProject.usesShaders do playerProject.renderer = .GPU
	if !Application_Setup(app, fmt.tprintf("%s", playerProject.name), playerProject.size, playerProject.renderer, playerProject.window, audio) {
		return false
	}

	game := new(Game)
	game.size = playerProject.size
	game.scaleMode = playerProject.scaleMode
	if options.physicsDebug do playerProject.physics.debugDraw = true
	game.devKeys = options.dev
	if options.live do LiveLink_Start(game)
	quitAfter = options.quitAfter
	game.build = proc(game: ^Game) {
		if !Game_LoadProject(game, &playerProject, projectDir) {
			log.warn("Some scenes failed to load")
		}
		if restoreText != "" {
			if Game_RestoreSnapshot(game, restoreText) do log.info("Hot reload: restarted where the game was")
			delete(restoreText)
			restoreText = ""
		}
		// --quit-after: the game's frames count down to a normal quit (set here: Game_Init, which
		// runs build, sets `update` first)
		if quitAfter > 0 {
			game.update = proc(game: ^Game, events: []sdl.Event, deltaTime: f64) {
				Game_Update(game, events, deltaTime)
				quitAfter -= deltaTime
				if quitAfter <= 0 {
					log.info("Quitting (--quit-after)")
					game.shouldQuit = true
				}
			}
		}
	}
	App_SetGame(app, game)
	return true
}

// The project being played. Game.build has no user data, so it reads these
@(private="file")
playerProject: ProjectData
@(private="file")
projectDir: string
// Seconds left before --quit-after quits (0: no limit)
@(private="file")
quitAfter: f64
// --restore's snapshot, applied once the project is loaded
@(private="file")
restoreText: string


// What the player was asked to do (`Player_ParseArgs`)
PlayerOptions :: struct {
	// The project folder ("." when none was given)
	projectDir: string,
	// Play from this scene instead of the project's start scene ("" for the start scene)
	scene: string,
	// Print the registered scripts and exit
	describe: bool,
	// Draw the physics shapes, whatever the project says
	physicsDebug: bool,
	// Developer keys (`Game.devKeys`); the editor's Play passes it, exports never run with it
	dev: bool,
	// `--live`: answer an editor's live view on stdin / stdout (live.odin); the editor's Play
	live: bool,
	// A project folder was named on the command line (otherwise an exported game finds its own)
	folderGiven: bool,
	// `--renderer <name>`: draw with this one, whatever the project says ("" for the project's)
	renderer: string,
	// `--quit-after <seconds>`: quit once the game has run that long (0: run until it quits);
	// CI starts exported games with it to check they start and stop cleanly
	quitAfter: f64,
	// `--audio-device <name>`: play sound on this device ("" for the system's default)
	audioDevice: string,
	// `--list-audio-devices`: print the playback devices' names and exit
	listAudioDevices: bool,
	// `--restore <file>`: start where a snapshot left off (its scene, globals, nodes: hot_reload.odin)
	restore: string,
}

/*
Where an exported game's project is: the data pack at the end of the program (a single-file
export: `PACK_ROOT`), else the `data` folder next to the program (how the editor's
desktop exports lay a game out), or the program's own folder, or a macOS app's
`Contents/Resources/data` (the program is in `Contents/MacOS`), or else the current folder. Asset
paths are relative to it, so the game runs from wherever it's started.

Returns:
- The folder (temp allocated)
*/
Player_FindExportedProject :: proc() -> string {
	// A single-file export: the project is in the data pack at the end of the program (pack.odin)
	if Pack_Open() && Pack_Has(JoinPath(PACK_ROOT, "project.xml")) do return PACK_ROOT
	exeDir, ok := Platform_ExecutableDir()
	if ok {
		// data/ beside it (desktop exports), its own folder, or a macOS app's Contents/Resources/data
		for candidate in ([]string{"data", ".", "../Resources/data"}) {
			dir := JoinPath(exeDir, candidate)
			if Platform_FileExists(JoinPath(dir, "project.xml")) do return dir
		}
	}
	return "."
}

/*
Reads the player's command line: `[<project folder>] [--scene <name>] [--physics-debug] [--dev]
[--renderer <name>] [--audio-device <name>] [--quit-after <seconds>]`, or `--describe-scripts`, or
`--list-audio-devices` (see `Player_Run`). The folder defaults to the current
one; flags may come in any order.

Inputs:
- args: The command line, program name first

Returns:
- The options (strings point into `args`), and false if the command line isn't valid (a second
  folder, or `--scene` / `--renderer` without a value)

Example:
	options, ok := e.Player_ParseArgs({"player", "mygame", "--scene", "Level2"})
	if ok do log.infof("playing %s from %s", options.projectDir, options.scene)
*/
Player_ParseArgs :: proc(args: []string) -> (PlayerOptions, bool) {
	options := PlayerOptions{projectDir = "."}
	for i := 1; i < len(args); i += 1 {
		switch args[i] {
		case "--describe-scripts":
			options.describe = true
		case "--physics-debug":
			options.physicsDebug = true
		case "--dev":
			options.dev = true
		case "--live":
			options.live = true
		case "--scene":
			if i + 1 >= len(args) do return options, false
			options.scene = args[i + 1]
			i += 1
		case "--restore":
			if i + 1 >= len(args) do return options, false
			options.restore = args[i + 1]
			i += 1
		case "--renderer":
			if i + 1 >= len(args) do return options, false
			options.renderer = args[i + 1]
			i += 1
		case "--audio-device":
			if i + 1 >= len(args) do return options, false
			options.audioDevice = args[i + 1]
			i += 1
		case "--list-audio-devices":
			options.listAudioDevices = true
		case "--quit-after":
			if i + 1 >= len(args) do return options, false
			seconds, ok := strconv.parse_f64(args[i + 1])
			if !ok || seconds <= 0 do return options, false
			options.quitAfter = seconds
			i += 1
		case:
			if options.folderGiven do return options, false
			options.projectDir = args[i]
			options.folderGiven = true
		}
	}
	return options, true
}

package engine

import "core:fmt"
import "core:log"
import "core:path/filepath"

/*
The game player: runs a project saved by the editor.

	player <project folder>          play it
	player --describe-scripts        print the registered scripts as JSON, and exit

`Player_Run` is the whole program. The engine's own `player/` package calls it with no game code;
a project with scripts gets its own player, generated by the editor, that imports the project's
`scripts` package (which registers its scripts from `@(init)` procedures) and calls it:

	package main

		import e "engine:."
	import scripts "project:scripts"
	_ :: scripts

	main :: proc() {
		os.exit(e.Player_Run(os.args))
	}

Inputs:
- args: The command line, program name first

Returns:
- The exit code: 0 after a normal quit, 1 if the project couldn't be loaded or started
*/
Player_Run :: proc(args: []string) -> int {
	context.logger = log.create_console_logger(.Info)
	if len(args) > 1 && args[1] == "--describe-scripts" {
		fmt.println(Script_DescribeJSON(context.temp_allocator))
		return 0
	}

	projectDir = len(args) > 1 ? args[1] : "."
	projectFile, _ := filepath.join({projectDir, "project.xml"}, context.allocator)
	defer delete(projectFile)

	err: ProjectError
	playerProject, err = LoadProjectFile(projectFile)
	if err != .None {
		log.errorf("Couldn't load project %s: %v", projectFile, err)
		return 1
	}
	defer ProjectData_Destroy(&playerProject)
	log.infof("Playing '%s' (%d scenes, start: %s, %d scripts registered)",
		playerProject.name, len(playerProject.scenes), playerProject.startScene, len(Script_All()))

	app := Application{}
	if !Application_Setup(&app, fmt.tprintf("%s", playerProject.name), playerProject.size) {
		return 1
	}
	defer Application_Cleanup(&app)

	game := new(Game)
	game.size = playerProject.size
	game.scaleMode = playerProject.scaleMode
	game.build = proc(game: ^Game) {
		if !Game_LoadProject(game, &playerProject, projectDir) {
			log.warn("Some scenes failed to load")
		}
	}
	Application_Run(&app, game)
	log.info("Game closed")
	return 0
}

// The project being played. Game.build has no user data, so it reads these
@(private="file")
playerProject: ProjectData
@(private="file")
projectDir: string

